{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "items",
    "unknownScope"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "interaction.schema.json"
      }
    },
    "unknownScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
