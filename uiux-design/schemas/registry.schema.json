{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UIUX Design Registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "entities",
    "unknownScope",
    "migrations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "unknownScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:%-]+$",
      "maxLength": 512
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "dimension",
        "subject"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "dimension": {
          "enum": [
            "visual",
            "information",
            "motion",
            "interaction"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "reviewed",
            "implemented",
            "verified",
            "failed",
            "blocked",
            "stale",
            "skipped"
          ]
        },
        "decision": {
          "enum": [
            null,
            "keep",
            "refine",
            "add",
            "replace",
            "simplify",
            "repair",
            "remove"
          ]
        },
        "gates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "reason"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "unknown",
                  "na"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "description"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "component",
        "context",
        "checks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "protection": {
          "enum": [
            "open",
            "preferred",
            "approved",
            "locked",
            "protected"
          ]
        },
        "sourceFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    }
  }
}
